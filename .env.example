# Copy to .env and fill in real values. Do NOT commit .env.
NODE_ENV=development

# --- Database ---
POSTGRES_DB=change_me
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# --- Cache ---
REDIS_PASSWORD=change_me

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me

# --- Data provider (obtain real endpoints from the maintainer) ---
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_API_URL=
REALTIME_API_URL=
REALTIME_INSTRUMENT_ID=
REALTIME_DOMAIN_ID=1

# --- Frontend (optional; have sane defaults if omitted) ---
# VITE_API_BASE_URL defaults to "/api"
VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET defaults to "http://localhost:3000"
VITE_API_PROXY_TARGET=
